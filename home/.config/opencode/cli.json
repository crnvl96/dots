{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "rosepine",
    "mode": "system"
  },
  "animations": true,
  "session": {
    "sidebar": "auto",
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "low",
    "image_preview": false,
    "tps": true,
    "new_location": "launch",
    "permissions": "prompt"
  },
  "tabs": {
    "mode": "auto",
    "layout": "horizontal"
  },
  "diffs": {
    "view": "unified",
    "wrap": "word"
  }
}

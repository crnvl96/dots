// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "vim_mode": true,
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha"
  },
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
  "disable_ai": true,
  "cli_default_open_behavior": "existing_window",
  "buffer_line_height": "comfortable",
  "session": {
    "trust_all_worktrees": true
  },
  // font family & size
  "mermaid_font_family": "Berkeley Mono",
  "ui_font_family": "Berkeley Mono",
  "buffer_font_family": "Berkeley Mono",
  "agent_buffer_font_family": "Berkeley Mono",
  "agent_ui_font_family": "Berkeley Mono",
  "agent_buffer_font_size": 16.0,
  "agent_ui_font_size": 16.0,
  "markdown_preview": {
    "font_size": 14.0,
    "code_font_family": "Berkeley Mono",
    "font_family": "Berkeley Mono"
  },
  "ui_font_size": 16.0,
  "buffer_font_size": 14.0,
  "terminal": {
    "font_family": "Berkeley Mono",
    "font_size": 14.0
  },
}

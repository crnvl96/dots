# Ghostty configuration
theme = light:Rose Pine Dawn,dark:Rose Pine
font-family = Berkeley Mono
font-size = 13
window-theme = auto

macos-option-as-alt = true

# Bell: keep resize/keybind feedback silent.
bell-features = no-system,no-audio,attention,title,no-border
bell-audio-volume = 0

# Shell integration
shell-integration = detect

# Cursor
shell-integration-features = no-cursor
cursor-style = block
cursor-style-blink = false

# Keep new terminals in the current shell's working directory.
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

# Tabs
keybind = cmd+t=new_tab
keybind = cmd+1=goto_tab:1
keybind = cmd+2=goto_tab:2
keybind = cmd+3=goto_tab:3
keybind = cmd+4=goto_tab:4
keybind = cmd+5=goto_tab:5
keybind = cmd+6=goto_tab:6
keybind = cmd+7=goto_tab:7
keybind = cmd+8=goto_tab:8
keybind = cmd+9=goto_tab:9
keybind = cmd+r=prompt_tab_title

# Splits
keybind = cmd+ctrl+arrow_up=resize_split:up,50
keybind = cmd+ctrl+arrow_down=resize_split:down,50
keybind = cmd+ctrl+arrow_left=resize_split:left,300
keybind = cmd+ctrl+arrow_right=resize_split:right,300
keybind = cmd+ctrl+==equalize_splits

# Move between neighboring split panes: h/j/k/l = left/down/up/right.
keybind = cmd+h=goto_split:left
keybind = cmd+j=goto_split:down
keybind = cmd+k=goto_split:up
keybind = cmd+l=goto_split:right

# Reload this configuration.
keybind = cmd+shift+r=reload_config

{
  "mcpServers": {
    "radius": {
      "url": "https://radius.pi.dev/mcp",
      "auth": {
        "provider": "radius"
      }
    },
    "perplexity": {
      "url": "https://api.perplexity.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${PERPLEXITY_API_KEY}"
      },
      "timeout": 180,
      "exposure": "direct",
      "description": "Perplexity web search, answers, research, and reasoning"
    },
    "spacesheep": {
      "url": "https://mcp.spacesheep.dev/mcp",
      "description": "Publish, read, and share spacesheep pages, and manage account settings",
      "enabled": false
    }
  }
}

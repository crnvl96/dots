{
  "mcpServers": {
    "perplexity": {
      "url": "https://api.perplexity.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${PERPLEXITY_API_KEY}"
      },
      "timeout": 180,
      "exposure": "direct",
      "description": "Perplexity web search, answers, research, and reasoning",
      "enabled": true
    },
    "inkdrop": {
      "command": "npx",
      "args": [
        "-y",
        "@inkdropapp/mcp-server@latest"
      ],
      "env": {
        "INKDROP_LOCAL_SERVER_URL": "http://localhost:19840",
        "INKDROP_LOCAL_USERNAME": "inkdrop",
        "INKDROP_LOCAL_PASSWORD": "${INKDROP_LOCAL_PASSWORD}"
      }
    }
  }
}
